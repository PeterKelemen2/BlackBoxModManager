<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BlackboxModManager.Core</RootNamespace>
    <AssemblyName>BlackboxModManager.Core</AssemblyName>
    <!-- LZCompressLib.dll is a native x64 library. The host process must be x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- This one reference pulls in Nikki and CoreExtensions. -->
    <ProjectReference Include="..\..\third_party\Endscript\Endscript\Endscript.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- XxHash. We identify a file by the hash of its content, never by size and time. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <!-- rar and 7z. System.IO.Compression reads zip, and it reads nothing else. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

</Project>
