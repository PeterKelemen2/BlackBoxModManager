<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BlackboxModManager.Core</RootNamespace>
    <AssemblyName>BlackboxModManager.Core</AssemblyName>
    <!-- LZCompressLib.dll is a native x64 library. The host process must be x64. -->
