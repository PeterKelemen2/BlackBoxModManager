<Window
  x:Class="BlackboxModManager.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:BlackboxModManager.App.Theme"
  Title="Blackbox Mod Manager"
  Width="1040"
  Height="700"
  MinWidth="820"
  MinHeight="520"
  Background="{StaticResource SurfaceBase}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  The game install. The application asks for it in a dialog, never on a console.  -->
    <GroupBox
      Grid.Row="0"
      Margin="0,0,0,8"
      Padding="8"
      Header="Game">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <!--
            The picker holds the games that a listing of a real install confirmed. A
            switch reloads the install, the profiles, and the mods.
          -->
          <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
            <TextBlock
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              Text="Game" />
            <ComboBox
              Width="320"
              DisplayMemberPath="DisplayName"
              ItemsSource="{Binding Games}"
              SelectedItem="{Binding SelectedGame, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock
            Style="{StaticResource Heading}"
            Text="{Binding GameStatus}"
            TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding GamePath}" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource Hint}"
            Text="{Binding DeployedState}" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource Hint}"
            Text="{Binding BinaryStatus}" />
          <!--
            The volume of the mod store decides whether a deploy can use hard links, so the
            path belongs on screen and not only in the log.
          -->
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource Hint}"
            Text="{Binding ModStoreStatus}"
            TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding DetectGameCommand}" Content="Detect" />
            <Button Command="{Binding BrowseGameCommand}" Content="Browse" />
            <Button
              Margin="0"
              Command="{Binding SetBinaryCommand}"
              Content="Binary install" />
          </StackPanel>
          <StackPanel
            Margin="0,4,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
              Margin="0"
              Command="{Binding SetModStoreCommand}"
              Content="Mod store"
              ToolTip="Move the mod store. A store on the volume of the game makes every deploy use hard links." />
          </StackPanel>
        </StackPanel>
      </Grid>
    </GroupBox>

    <!--  The profile. A profile fully determines the deployed result.  -->
    <StackPanel
      Grid.Row="1"
      Margin="0,0,0,8"
      Orientation="Horizontal">
      <TextBlock
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Text="Profile" />
      <ComboBox
        Width="220"
        Margin="0,0,8,0"
        ItemsSource="{Binding ProfileNames}"
        SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />
      <Button Command="{Binding NewProfileCommand}" Content="New" />
      <Button Command="{Binding RenameProfileCommand}" Content="Rename" />
      <Button Command="{Binding DeleteProfileCommand}" Content="Delete" />
    </StackPanel>

    <!--  The mods and the log.  -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <GroupBox
        Grid.Column="0"
        Padding="4"
        Header="Mods, in load order. A later mod overrides an earlier one.">
        <!--
          The DataGrid of step 9 became a row list in step 10, so that a row can carry a
          drag handle and a drop can reorder it. See docs/roadmap/10-dark-theme.md, Part
          D. The event handlers live in MainWindow.xaml.cs, on this ItemsControl, because
          the row template of Theme/Parts.xaml has no code-behind of its own.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl
            x:Name="ModList"
            AllowDrop="True"
            DragLeave="ModList_DragLeave"
            DragOver="ModList_DragOver"
            Drop="ModList_Drop"
            ItemTemplate="{StaticResource ModRowTemplate}"
            ItemsSource="{Binding Mods}"
            PreviewMouseLeftButtonDown="ModList_PreviewMouseLeftButtonDown"
            PreviewMouseMove="ModList_PreviewMouseMove" />
        </ScrollViewer>
      </GroupBox>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Stretch" />

      <TabControl Grid.Column="2">
        <!--  The variants of a Binary mod, and the questions that its script asks.  -->
        <TabItem Header="Mod">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
              Grid.Row="0"
              Margin="0,0,0,8"
              Style="{StaticResource Hint}"
              Text="{Binding DetailsHeader}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Variants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ListRow}">
                      <StackPanel>
                        <!--
                          A mod folder holds several variants and the user picks any
                          number of them. This is a multiple selection.
                        -->
                        <CheckBox
                          Content="{Binding Name}"
                          FontWeight="Bold"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsInstallable}" />
                        <TextBlock
                          Margin="20,2,0,0"
                          Style="{StaticResource Hint}"
                          Text="{Binding Problem}"
                          Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}" />
                        <ItemsControl Margin="20,4,0,0" ItemsSource="{Binding Questions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,6">
                                <!--  The description of the script is the caption.  -->
                                <TextBlock
                                  Margin="0,0,0,2"
                                  Text="{Binding Description}"
                                  TextWrapping="Wrap" />
                                <ComboBox
                                  ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                  Visibility="{Binding IsCombobox, Converter={StaticResource BoolToVisible}}" />
                                <CheckBox
                                  Content="On"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisible}}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!--  The settings of the selected ASI mod. One group per section, one row per key.  -->
        <TabItem Header="Settings">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
              Grid.Row="0"
              Margin="0,0,0,8"
              Style="{StaticResource Hint}"
              Text="{Binding SettingsHeader}"
              TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SettingsFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock
                        FontWeight="Bold"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                      <!--
                        An unmatched .ini gets its own heading and no owner. Not every .ini
                        beside a plugin is the settings of that plugin.
                      -->
                      <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource Hint}"
                        Text="{Binding Owner}"
                        TextWrapping="Wrap" />
                      <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock
                              Style="{StaticResource Hint}"
                              Text="{Binding}"
                              TextWrapping="Wrap" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <GroupBox
                              Margin="0,0,0,6"
                              Padding="6"
                              Header="{Binding Name}">
                              <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Key}"
                                        TextWrapping="Wrap" />
                                      <!--
                                        The marker shows the comment of the line and nothing
                                        else. A comment is not a schema, so the text passes
                                        through unchanged. A key with no comment shows no
                                        marker.
                                      -->
                                      <Border
                                        Grid.Column="1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HelpMarker}"
                                        ToolTip="{Binding Comment}"
                                        ToolTipService.ShowDuration="60000"
                                        Visibility="{Binding HasComment, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Style="{StaticResource HelpMarkerGlyph}" Text="?" />
                                      </Border>
                                      <!--  The editor comes from the value alone.  -->
                                      <CheckBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="On"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisible}}" />
                                      <TextBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisible}}" />
                                      <TextBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Visibility="{Binding IsText, Converter={StaticResource BoolToVisible}}" />
                                      <!--
                                        Every editor is a guess. FPSLimit = -1 looks like a
                                        number and ImproveGamepadSupport = 0 looks like a
                                        check box with five states. This is the way back.
                                      -->
                                      <StackPanel
                                        Grid.Column="3"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <CheckBox
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Content="Text"
                                          IsChecked="{Binding FreeText, Mode=TwoWay}"
                                          ToolTip="Type any value. Use this when the editor does not fit the option." />
                                        <Button
                                          Padding="6,1"
                                          ui:Kind.Value="Quiet"
                                          Command="{Binding ResetCommand}"
                                          Content="Reset"
                                          ToolTip="Put the value of the mod back."
                                          Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisible}}" />
                                      </StackPanel>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </GroupBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!--
          The ASI loader. The game directory holds one file at each loader path, and
          several mods ship one each. This application never chooses for the user.
        -->
        <TabItem Header="Loader">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
              Grid.Row="0"
              Margin="0,0,0,8"
              Style="{StaticResource Hint}"
              Text="{Binding LoaderHeader}"
              TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Loaders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ListRow}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                          <TextBlock FontWeight="Bold" Text="{Binding ProxyName}" />
                          <TextBlock
                            Margin="0,2,0,0"
                            Text="{Binding Supplier}"
                            TextWrapping="Wrap" />
                          <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource Hint}"
                            Text="{Binding Detail}"
                            TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                          Grid.Column="1"
                          Margin="0"
                          VerticalAlignment="Top"
                          Command="{Binding DataContext.ChooseLoaderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Content="Choose" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!--
          Name no font family in this window. A family that the machine does not hold
          ends in MS.Internal.Invariant.FailFast, which kills the process with no dialog
          and no catchable exception. Wine holds no Consolas, and a log line then killed
          the application.
        -->
        <TabItem Header="Log">
          <ListBox
            x:Name="LogList"
            HorizontalContentAlignment="Stretch"
            BorderThickness="0"
            ItemsSource="{Binding Log}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource LogLine}" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>

        <TabItem Header="Conflicts">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox
              Grid.Row="0"
              HorizontalContentAlignment="Stretch"
              BorderThickness="0"
              ItemsSource="{Binding Conflicts}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource ConflictLine}" Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button
              Grid.Row="1"
              Margin="0,6,0,0"
              HorizontalAlignment="Left"
              Command="{Binding RefreshConflictsCommand}"
              Content="Check again" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!--  The actions.  -->
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button
          MinWidth="110"
          Command="{Binding ImportArchiveCommand}"
          Content="Import archive" />
        <Button
          MinWidth="110"
          Command="{Binding ImportFolderCommand}"
          Content="Import folder" />
        <Button
          ui:Kind.Value="Danger"
          Command="{Binding RemoveModCommand}"
          Content="Remove" />
        <Button
          Command="{Binding SetModGameCommand}"
          Content="Set game"
          ToolTip="Give the selected drop-in mod the game that this window manages." />
        <Button Command="{Binding MoveUpCommand}" Content="Move up" />
        <Button Command="{Binding MoveDownCommand}" Content="Move down" />
        <!--
          A deploy that the verify stopped leaves its result in the staging copy, and the
          failure is only readable from inside that directory.
        -->
        <Button
          ui:Kind.Value="Quiet"
          Command="{Binding ShowFoldersCommand}"
          Content="Folders"
          ToolTip="Open the staging copy, the vanilla copy, the mod store, or the logs." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <CheckBox
          Margin="0,0,12,0"
          VerticalAlignment="Center"
          Content="Full verify"
          IsChecked="{Binding FullVerify, Mode=TwoWay}"
          ToolTip="Hash every file of the staging copy. This is slow and exact." />
        <Button
          MinWidth="100"
          ui:Kind.Value="Success"
          Command="{Binding DeployCommand}"
          Content="Deploy" />
        <Button
          MinWidth="120"
          Margin="0"
          ui:Kind.Value="Danger"
          Command="{Binding RevertCommand}"
          Content="Revert to vanilla" />
      </StackPanel>
    </Grid>

    <StatusBar Grid.Row="4" Margin="0,8,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
