<Window
  x:Class="BlackboxModManager.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:BlackboxModManager.App.Theme"
  Title="Blackbox Mod Manager"
  Width="1040"
  Height="700"
  MinWidth="820"
  MinHeight="520"
  Background="{StaticResource SurfaceBase}">
  <!--
    DragLayer is the host of the floating copy of a drag. It has a name because the adorner
    needs a host outside the mod list. See docs/roadmap/11-ui-polish.md, Part B.
  -->
  <Grid x:Name="DragLayer" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      The bar. One row holds the game, the profile, and the way into the settings.

      Step 12 replaced a Game card of five status lines and four buttons, plus a profile row
      of three more. Every path setting lives in ConfigWindow now, and the state text lives in
      the status bar below. See docs/roadmap/12-minimal-ui.md, Part G.
    -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <!--
          The picker holds the games that a listing of a real install confirmed. A switch
          reloads the install, the profiles, and the mods.
        -->
        <!--
          <b>The picker names the game with an ItemTemplate and never with DisplayMemberPath.</b>
          The closed box of a ComboBox draws SelectionBoxItem through SelectionBoxItemTemplate,
          and the template in Controls.xaml binds that one property alone. DisplayMemberPath
          reaches the open list and misses the closed box, which then falls back to ToString and
          reads "Need for Speed Underground 2 (Underground2)". A template covers both.
        -->
        <ComboBox
          Width="240"
          Margin="0,0,8,0"
          ItemsSource="{Binding Games}"
          SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
          ToolTip="The game that this window manages.">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!--  The profile. A profile fully determines the deployed result.  -->
        <ComboBox
          Width="200"
          Margin="0,0,4,0"
          ItemsSource="{Binding ProfileNames}"
          SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
          ToolTip="The profile that a deploy writes. A profile holds the mods and the load order." />

        <Button
          x:Name="ProfileMenuButton"
          Margin="0"
          ui:Kind.Value="Quiet"
          Click="OnOpenOwnMenu"
          Style="{StaticResource IconButton}"
          ToolTip="Make a new profile, rename this one, or delete it.">
          <Path Data="{StaticResource IconMore}" Style="{StaticResource IconGlyph}" />
          <Button.ContextMenu>
            <!--
              A ContextMenu is not in the visual tree of the window, so it inherits no
              DataContext that a binding can rely on. Every menu of this window takes the
              DataContext of its placement target instead.
            -->
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Command="{Binding NewProfileCommand}" Header="New profile" />
              <MenuItem Command="{Binding RenameProfileCommand}" Header="Rename this profile" />
              <Separator />
              <MenuItem Command="{Binding DeleteProfileCommand}" Header="Delete this profile" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>

      <Button
        Grid.Column="1"
        Margin="0"
        ui:Kind.Value="Quiet"
        Click="OnOpenConfig"
        Style="{StaticResource IconButton}"
        ToolTip="Open the settings. The game directory, the Binary install, the mod store, and the workspace all live there.">
        <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconGlyph}" />
      </Button>
    </Grid>

    <!--  The mods and the log.  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <!--
        The card carries no header. A row list of mods with a drag handle needs no caption,
        and the empty state below names the panel on the one screen where the rows cannot.
      -->
      <GroupBox Grid.Column="0" Padding="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!--
            The mod toolbar. Four glyphs and no label. The tooltip of each button is the only
            name that it has, so no button may lose one.

            The three buttons on the right act on the selected mod, and CanActOnMod grays all
            three out while nothing is selected. See docs/roadmap/12-minimal-ui.md, Part F.
          -->
          <Grid Grid.Row="0" Margin="2,2,2,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
              x:Name="ImportButton"
              Grid.Column="0"
              Margin="0"
              Click="OnOpenOwnMenu"
              Style="{StaticResource IconButton}"
              ToolTip="Add a mod. Choose an archive or a directory, or drop one on this list.">
              <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconGlyph}" />
              <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Command="{Binding ImportArchiveCommand}" Header="Archive…" />
                  <MenuItem Command="{Binding ImportFolderCommand}" Header="Folder…" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button
                Command="{Binding MoveUpCommand}"
                Style="{StaticResource IconButton}"
                ToolTip="Move the mod one place up. An earlier mod loads first.">
                <Path Data="{StaticResource IconChevronUp}" Style="{StaticResource IconGlyph}" />
              </Button>
              <Button
                Command="{Binding MoveDownCommand}"
                Style="{StaticResource IconButton}"
                ToolTip="Move the mod one place down. A later mod overrides an earlier one.">
                <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource IconGlyph}" />
              </Button>
              <Button
                Margin="6,0,0,0"
                ui:Kind.Value="DangerOutline"
                Command="{Binding RemoveModCommand}"
                Style="{StaticResource IconButton}"
                ToolTip="Remove the mod from the store. This deletes the files of the mod.">
                <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconGlyph}" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <!--
              The DataGrid of step 9 became a row list in step 10, so that a row can carry a
              drag handle and a drop can reorder it. Step 11 replaced the insertion line with a
              ghost slot. See docs/roadmap/11-ui-polish.md, Part B. The event handlers live in
              MainWindow.xaml.cs, on this ItemsControl, because the row template of
              Theme/Parts.xaml has no code-behind of its own.

              Step 12 added the right button handler and the drop of a file from outside. See
              docs/roadmap/12-minimal-ui.md, Parts E and I.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <!--
                Two lists in one column. The mods sit above, and the imports that still run
                sit below, which is where the finished mod lands.

                The import rows stay out of ModList on purpose. ModList carries the drag,
                the drop, and the row menu, and each one of those acts on a mod that the
                store holds. An import has no mod yet.
              -->
              <StackPanel>
                <ItemsControl
                  x:Name="ModList"
                  AllowDrop="True"
                  DragLeave="ModList_DragLeave"
                  DragOver="ModList_DragOver"
                  Drop="ModList_Drop"
                  GiveFeedback="ModList_GiveFeedback"
                  ItemTemplate="{StaticResource ModRowTemplate}"
                  ItemsSource="{Binding Mods}"
                  PreviewMouseLeftButtonDown="ModList_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="ModList_PreviewMouseMove"
                  PreviewMouseRightButtonDown="ModList_PreviewMouseRightButtonDown"
                  QueryContinueDrag="ModList_QueryContinueDrag" />

                <ItemsControl
                  ItemTemplate="{StaticResource ImportRowTemplate}"
                  ItemsSource="{Binding Imports}" />
              </StackPanel>
            </ScrollViewer>

            <!--
              The empty state. It covers the list only while the profile holds no mod, so it
              never sits over a row and never blocks a drag.

              The trigger reads Mods.Count and Imports.Count. An ObservableCollection raises
              PropertyChanged for Count, so the panel appears and disappears with no code and
              no converter. The first import into an empty profile draws a row, and this
              panel must give way to it.

              The tile opens the menu of ImportButton above. One menu, one pair of answers.
            -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Mods.Count}" Value="0" />
                        <Condition Binding="{Binding Imports.Count}" Value="0" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Button
                HorizontalAlignment="Center"
                Click="OnOpenImportMenu"
                Style="{StaticResource AddModButton}"
                ToolTip="Add a mod. Choose an archive or a directory, or drop one on this list." />
              <TextBlock
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource Heading}"
                Text="Add a mod" />
              <TextBlock
                MaxWidth="260"
                HorizontalAlignment="Center"
                Style="{StaticResource Hint}"
                Text="The mods deploy in this order. A later mod overrides an earlier one."
                TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </GroupBox>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Stretch" />

      <TabControl Grid.Column="2">
        <!--  The variants of a Binary mod, and the questions that its script asks.  -->
        <TabItem Header="Mod">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
              Grid.Row="0"
              Margin="0,0,0,8"
              Style="{StaticResource Hint}"
              Text="{Binding DetailsHeader}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Variants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ListRow}">
                      <StackPanel>
                        <!--
                          A mod folder holds several variants and the user picks any
                          number of them. This is a multiple selection.
                        -->
                        <CheckBox
                          Content="{Binding Name}"
                          FontWeight="Bold"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsInstallable}" />
                        <TextBlock
                          Margin="20,2,0,0"
                          Style="{StaticResource Hint}"
                          Text="{Binding Problem}"
                          Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}" />
                        <ItemsControl Margin="20,4,0,0" ItemsSource="{Binding Questions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,6">
                                <!--  The description of the script is the caption.  -->
                                <TextBlock
                                  Margin="0,0,0,2"
                                  Text="{Binding Description}"
                                  TextWrapping="Wrap" />
                                <ComboBox
                                  ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                  Visibility="{Binding IsCombobox, Converter={StaticResource BoolToVisible}}" />
                                <CheckBox
                                  Content="On"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisible}}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!--  The settings of the selected ASI mod. One group per section, one row per key.  -->
        <TabItem Header="Settings">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
              Grid.Row="0"
              Margin="0,0,0,8"
              Style="{StaticResource Hint}"
              Text="{Binding SettingsHeader}"
              TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SettingsFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock
                        FontWeight="Bold"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                      <!--
                        An unmatched .ini gets its own heading and no owner. Not every .ini
                        beside a plugin is the settings of that plugin.
                      -->
                      <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource Hint}"
                        Text="{Binding Owner}"
                        TextWrapping="Wrap" />
                      <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock
                              Style="{StaticResource Hint}"
                              Text="{Binding}"
                              TextWrapping="Wrap" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <GroupBox
                              Margin="0,0,0,6"
                              Padding="6"
                              Header="{Binding Name}">
                              <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Key}"
                                        TextWrapping="Wrap" />
                                      <!--
                                        The marker shows the comment of the line and nothing
                                        else. A comment is not a schema, so the text passes
                                        through unchanged. A key with no comment shows no
                                        marker.
                                      -->
                                      <Border
                                        Grid.Column="1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HelpMarker}"
                                        ToolTip="{Binding Comment}"
                                        ToolTipService.ShowDuration="60000"
                                        Visibility="{Binding HasComment, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Style="{StaticResource HelpMarkerGlyph}" Text="?" />
                                      </Border>
                                      <!--  The editor comes from the value alone.  -->
                                      <CheckBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="On"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisible}}" />
                                      <TextBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisible}}" />
                                      <TextBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Visibility="{Binding IsText, Converter={StaticResource BoolToVisible}}" />
                                      <!--
                                        Every editor is a guess. FPSLimit = -1 looks like a
                                        number and ImproveGamepadSupport = 0 looks like a
                                        check box with five states. This is the way back.
                                      -->
                                      <StackPanel
                                        Grid.Column="3"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <CheckBox
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Content="Text"
                                          IsChecked="{Binding FreeText, Mode=TwoWay}"
                                          ToolTip="Type any value. Use this when the editor does not fit the option." />
                                        <Button
                                          Padding="6,1"
                                          ui:Kind.Value="Quiet"
                                          Command="{Binding ResetCommand}"
                                          Content="Reset"
                                          ToolTip="Put the value of the mod back."
                                          Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisible}}" />
                                      </StackPanel>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </GroupBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!--
          The ASI loader. The game directory holds one file at each loader path, and
          several mods ship one each. This application never chooses for the user.
        -->
        <TabItem Header="Loader">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
              Grid.Row="0"
              Margin="0,0,0,8"
              Style="{StaticResource Hint}"
              Text="{Binding LoaderHeader}"
              TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Loaders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ListRow}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                          <TextBlock FontWeight="Bold" Text="{Binding ProxyName}" />
                          <TextBlock
                            Margin="0,2,0,0"
                            Text="{Binding Supplier}"
                            TextWrapping="Wrap" />
                          <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource Hint}"
                            Text="{Binding Detail}"
                            TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                          Grid.Column="1"
                          Margin="0"
                          VerticalAlignment="Top"
                          Command="{Binding DataContext.ChooseLoaderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Content="Choose" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!--
          Name no font family in this window. A family that the machine does not hold
          ends in MS.Internal.Invariant.FailFast, which kills the process with no dialog
          and no catchable exception. Wine holds no Consolas, and a log line then killed
          the application.
        -->
        <TabItem Header="Log">
          <!--
            The margin holds the rows away from the rounded corners of the card. A selected
            row paints SurfacePressed, and a row at the last line would square off the
            corner without it.
          -->
          <!--
            HorizontalScrollBarVisibility must stay Disabled. A log line wraps only with
            this value. Every other value gives the item an endless width to measure in,
            and TextWrapping on the line then does nothing.
          -->
          <ListBox
            x:Name="LogList"
            Margin="6"
            HorizontalContentAlignment="Stretch"
            BorderThickness="0"
            ItemsSource="{Binding Log}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource LogLine}" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>

        <TabItem Header="Conflicts">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  A conflict line wraps for the same reason as a log line.  -->
            <ListBox
              Grid.Row="0"
              HorizontalContentAlignment="Stretch"
              BorderThickness="0"
              ItemsSource="{Binding Conflicts}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource ConflictLine}" Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button
              Grid.Row="1"
              Margin="0,6,0,0"
              HorizontalAlignment="Left"
              Command="{Binding RefreshConflictsCommand}"
              Content="Check again" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!--
      The two actions. Both carry a colored edge and no fill, so neither one shouts across
      the window. See docs/roadmap/12-minimal-ui.md, Part C.
    -->
    <StackPanel
      Grid.Row="2"
      Margin="0,8,0,0"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        MinWidth="100"
        ui:Kind.Value="SuccessOutline"
        Command="{Binding DeployCommand}"
        Content="Deploy" />
      <Button
        MinWidth="120"
        Margin="0"
        ui:Kind.Value="DangerOutline"
        Command="{Binding RevertCommand}"
        Content="Revert to vanilla" />
    </StackPanel>

    <!--
      The bottom line. The left item says what the application is doing. The right item says
      what the game directory holds.

      The tooltip carries the three paths that step 12 took off the main window. It names its
      own DataContext, because a ToolTip sits outside the visual tree in the same way that a
      ContextMenu does.
    -->
    <StatusBar Grid.Row="3" Margin="0,8,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" />
      </StatusBarItem>
      <StatusBarItem HorizontalContentAlignment="Right">
        <TextBlock Text="{Binding StateSummary}" TextTrimming="CharacterEllipsis">
          <TextBlock.ToolTip>
            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <StackPanel MaxWidth="420">
                <TextBlock Text="{Binding GamePath}" TextWrapping="Wrap" />
                <TextBlock
                  Margin="0,4,0,0"
                  Text="{Binding BinaryStatus}"
                  TextWrapping="Wrap" />
                <TextBlock
                  Margin="0,4,0,0"
                  Text="{Binding ModStoreStatus}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </ToolTip>
          </TextBlock.ToolTip>
        </TextBlock>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
