<Window x:Class="BlackboxModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackbox Mod Manager" Height="700" Width="1040" MinHeight="520" MinWidth="820">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The game install. The application asks for it in a dialog, never on a console. -->
    <GroupBox Grid.Row="0" Header="Game" Padding="8" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="{Binding GameStatus}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding GamePath}" Style="{StaticResource Hint}" />
          <TextBlock Text="{Binding DeployedState}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding BinaryStatus}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Detect" Command="{Binding DetectGameCommand}" />
          <Button Content="Browse" Command="{Binding BrowseGameCommand}" />
          <Button Content="Binary install" Command="{Binding SetBinaryCommand}" Margin="0" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- The profile. A profile fully determines the deployed result. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Width="220" Margin="0,0,8,0"
                ItemsSource="{Binding ProfileNames}"
                SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" />
      <Button Content="New" Command="{Binding NewProfileCommand}" />
      <Button Content="Rename" Command="{Binding RenameProfileCommand}" />
      <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
    </StackPanel>

    <!-- The mods and the log. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="Mods, in load order. A later mod overrides an earlier one." Padding="4">
        <DataGrid ItemsSource="{Binding Mods}"
                  SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="On" Width="40"
                                    Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="#" Width="36" IsReadOnly="True" Binding="{Binding Order}" />
            <DataGridTextColumn Header="Mod" Width="*" IsReadOnly="True" Binding="{Binding Name}" />
            <DataGridTextColumn Header="Kind" Width="90" IsReadOnly="True" Binding="{Binding Kind}" />
            <DataGridTextColumn Header="Files" Width="60" IsReadOnly="True" Binding="{Binding FileCount}" />
            <DataGridTextColumn Header="Size" Width="80" IsReadOnly="True" Binding="{Binding Size}" />
          </DataGrid.Columns>
        </DataGrid>
      </GroupBox>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

      <TabControl Grid.Column="2">
        <!-- The variants of a Binary mod, and the questions that its script asks. -->
        <TabItem Header="Mod">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding DetailsHeader}" Style="{StaticResource Hint}"
                       Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Variants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
                      <StackPanel>
                        <!-- A mod folder holds several variants and the user picks any
                             number of them. This is a multiple selection. -->
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  IsEnabled="{Binding IsInstallable}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Problem}" Style="{StaticResource Hint}"
                                   Margin="20,2,0,0"
                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}" />
                        <ItemsControl ItemsSource="{Binding Questions}" Margin="20,4,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,6">
                                <!-- The description of the script is the caption. -->
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                          Visibility="{Binding IsCombobox, Converter={StaticResource BoolToVisible}}" />
                                <CheckBox Content="On" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisible}}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!-- Name no font family in this window. A family that the machine does not hold
             ends in MS.Internal.Invariant.FailFast, which kills the process with no dialog
             and no catchable exception. Wine holds no Consolas, and a log line then killed
             the application. -->
        <TabItem Header="Log">
          <ListBox x:Name="LogList" ItemsSource="{Binding Log}"
                   FontSize="11" BorderThickness="0"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>

        <TabItem Header="Conflicts">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox Grid.Row="0" ItemsSource="{Binding Conflicts}" BorderThickness="0"
                     FontSize="11" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="1" Content="Check again" Command="{Binding RefreshConflictsCommand}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- The actions. -->
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Content="Import archive" Command="{Binding ImportArchiveCommand}" MinWidth="110" />
        <Button Content="Import folder" Command="{Binding ImportFolderCommand}" MinWidth="110" />
        <Button Content="Remove" Command="{Binding RemoveModCommand}" />
        <Button Content="Move up" Command="{Binding MoveUpCommand}" />
        <Button Content="Move down" Command="{Binding MoveDownCommand}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <CheckBox Content="Full verify" IsChecked="{Binding FullVerify, Mode=TwoWay}"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  ToolTip="Hash every file of the staging copy. This is slow and exact." />
        <Button Content="Deploy" Command="{Binding DeployCommand}" MinWidth="100" />
        <Button Content="Revert to vanilla" Command="{Binding RevertCommand}" MinWidth="120" Margin="0" />
      </StackPanel>
    </Grid>

    <StatusBar Grid.Row="4" Margin="0,8,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
