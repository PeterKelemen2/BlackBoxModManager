<!--
  The default mode ends the application when the last window closes. A transient dialog,
  such as the deploy error message, is a window too. Closing it then closed the whole
  application. Only the close of the main window ends the application now.
-->
<Application
  x:Class="BlackboxModManager.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          A StaticResource cannot look forward. Colors and Metrics must come first,
          because every later file reads a token from one or both.
        -->
        <ResourceDictionary Source="Theme/Colors.xaml" />
        <ResourceDictionary Source="Theme/Metrics.xaml" />
        <ResourceDictionary Source="Theme/Icons.xaml" />
        <ResourceDictionary Source="Theme/Typography.xaml" />
        <ResourceDictionary Source="Theme/Controls.xaml" />
        <ResourceDictionary Source="Theme/Parts.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
