<Window x:Class="BlackboxModManager.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackbox Mod Manager" Width="680" Height="360" MinWidth="420" MinHeight="220"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="Heading" Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold"
               Margin="0,0,0,8" />

    <!-- A read-only text box and not a text block. A deploy message names paths and library
         errors, and the user has to be able to select it, scroll it, and copy it. -->
    <TextBox x:Name="Body" Grid.Row="1"
             IsReadOnly="True"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"
             BorderThickness="1" Padding="6" />

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="CopyState" Grid.Column="0" VerticalAlignment="Center"
                 TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,0,8,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="CopyButton" Content="Copy error" Click="OnCopy" MinWidth="100" />
        <Button Content="Close" IsDefault="True" IsCancel="True" Click="OnClose" MinWidth="80" Margin="0" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
