<Window
  x:Class="BlackboxModManager.App.Views.MessageWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="BlackBox Mod Manager"
  Width="680"
  Height="360"
  MinWidth="420"
  MinHeight="220"
  Background="{StaticResource SurfaceBase}"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      x:Name="Heading"
      Grid.Row="0"
      Margin="0,0,0,8"
      FontWeight="Bold"
      Foreground="{StaticResource DangerDefault}"
      TextWrapping="Wrap" />

    <!--
      A read-only text box and not a text block. A deploy message names paths and library
      errors, and the user has to be able to select it, scroll it, and copy it.
    -->
    <TextBox
      x:Name="Body"
      Grid.Row="1"
      Padding="6"
      AcceptsReturn="True"
      BorderThickness="1"
      HorizontalScrollBarVisibility="Disabled"
      IsReadOnly="True"
      TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto" />

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="CopyState"
        Grid.Column="0"
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Style="{StaticResource Hint}"
        TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button
          x:Name="CopyButton"
          MinWidth="100"
          Click="OnCopy"
          Content="Copy error" />
        <Button
          MinWidth="80"
          Margin="0"
          Click="OnClose"
          Content="Close"
          IsCancel="True"
          IsDefault="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
