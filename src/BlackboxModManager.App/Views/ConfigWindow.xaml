<Window
  x:Class="BlackboxModManager.App.Views.ConfigWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:BlackboxModManager.App.Theme"
  Title="Settings"
  Width="700"
  Height="720"
  MinWidth="520"
  MinHeight="420"
  Background="{StaticResource SurfaceBase}"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner">
  <!--
    Every path of this application. Step 12 took these four settings off the main window.
    See docs/roadmap/12-minimal-ui.md, Part H.

    <b>This window holds no logic.</b> It takes the MainViewModel as its DataContext and it
    binds to the commands that already exist. The code-behind opens it, sets the dialog
    owner, and nothing else.

    Step 17 gave the four path groups one shape and one interaction model. Read Parts A, C,
    and D of docs/roadmap/17-ui-consistency.md before you change a group.

    1. The status line says what the state is.
    2. The path box holds the path and nothing else. A group with no path hides the box.
    3. The hint line says what the choice costs.
    4. Change opens the picker. The default place is a button of its own.
    5. Open and Copy path sit on every group. Copy path works when Open does not.
  -->
  <Window.Resources>
    <!--
      The path box of a group. Four properties make a read-only box read as a line of text
      that a user can select.

      <b>BasedOn is not optional.</b> The TextBox style of Theme/Controls.xaml carries no
      x:Key, so it applies to every box that names no style of its own. A keyed style does
      not inherit from it. Without this attribute the box loses the theme foreground and
      draws black text on the dark surface.
    -->
    <Style
      x:Key="PathBox"
      BasedOn="{StaticResource {x:Type TextBox}}"
      TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  The Open and Copy path pair. Both sit under the buttons of the group.  -->
    <Style
      x:Key="PathIconRow"
      BasedOn="{StaticResource IconButtonSmall}"
      TargetType="Button">
      <Setter Property="Margin" Value="0,4,4,0" />
      <Setter Property="ui:Kind.Value" Value="Quiet" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">

        <!--  The game install. A deploy needs it, and nothing works without it.  -->
        <GroupBox
          Margin="0,0,0,12"
          Padding="10"
          Header="Game install">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock
                Style="{StaticResource Hint}"
                Text="{Binding GameStatus}"
                TextWrapping="Wrap" />
              <TextBox
                Style="{StaticResource PathBox}"
                Text="{Binding GamePath, Mode=OneWay}"
                Visibility="{Binding HasGamePath, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
              <Button
                Margin="0,0,0,4"
                HorizontalAlignment="Stretch"
                Command="{Binding DetectGameCommand}"
                Content="Detect"
                ToolTip="Search the common install directories." />
              <Button
                Margin="0"
                HorizontalAlignment="Stretch"
                Command="{Binding BrowseGameCommand}"
                Content="Browse"
                ToolTip="Choose the install directory of this game." />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                  Command="{Binding OpenDirectoryCommand}"
                  CommandParameter="{Binding GamePath}"
                  IsEnabled="{Binding HasGamePath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Open this directory in the file manager.">
                  <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button
                  Margin="0,4,0,0"
                  Command="{Binding CopyPathCommand}"
                  CommandParameter="{Binding GamePath}"
                  IsEnabled="{Binding HasGamePath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Copy this path to the clipboard.">
                  <Path Data="{StaticResource IconClipboard}" Style="{StaticResource IconGlyph}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </GroupBox>

        <!--  Binary. A Binary mod needs it. A drop-in mod does not.  -->
        <GroupBox
          Margin="0,0,0,12"
          Padding="10"
          Header="Binary install">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock
                Style="{StaticResource Hint}"
                Text="{Binding BinaryStatus}"
                TextWrapping="Wrap" />
              <TextBox
                Style="{StaticResource PathBox}"
                Text="{Binding BinaryPath, Mode=OneWay}"
                Visibility="{Binding HasBinaryPath, Converter={StaticResource BoolToVisible}}" />
              <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Hint}"
                Text="Only the hash lists of that install are read."
                TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
              <Button
                Margin="0"
                HorizontalAlignment="Stretch"
                Command="{Binding SetBinaryCommand}"
                Content="Browse"
                ToolTip="Choose the directory of the Binary 2.8.3 install." />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                  Command="{Binding OpenDirectoryCommand}"
                  CommandParameter="{Binding BinaryPath}"
                  IsEnabled="{Binding HasBinaryPath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Open this directory in the file manager.">
                  <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button
                  Margin="0,4,0,0"
                  Command="{Binding CopyPathCommand}"
                  CommandParameter="{Binding BinaryPath}"
                  IsEnabled="{Binding HasBinaryPath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Copy this path to the clipboard.">
                  <Path Data="{StaticResource IconClipboard}" Style="{StaticResource IconGlyph}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </GroupBox>

        <!--
          The mod store. The volume of this directory decides the cost of every deploy, so
          the hint says so on screen and not only in the log.
        -->
        <GroupBox
          Margin="0,0,0,12"
          Padding="10"
          Header="Mod store">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock
                Style="{StaticResource Hint}"
                Text="{Binding ModStoreStatus}"
                TextWrapping="Wrap" />
              <TextBox
                Style="{StaticResource PathBox}"
                Text="{Binding ModStorePath, Mode=OneWay}"
                Visibility="{Binding HasModStorePath, Converter={StaticResource BoolToVisible}}" />
              <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Hint}"
                Text="Hard links do not cross volumes. Keep the store on the volume of the game, or every deploy copies every byte."
                TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
              <Button
                Margin="0,0,0,4"
                HorizontalAlignment="Stretch"
                Command="{Binding SetModStoreCommand}"
                Content="Change"
                ToolTip="Choose another directory for the mod store." />
              <!--
                The default place is a button and no longer a row of a choice window. It
                shows only while the store sits somewhere else. See step 17, Part D.
              -->
              <Button
                Margin="0"
                HorizontalAlignment="Stretch"
                Command="{Binding UseDefaultModStoreCommand}"
                Content="Use the default place"
                ToolTip="Move it back under the application data directory.">
                <Button.Style>
                  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ModStoreIsDefault}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                  Command="{Binding OpenDirectoryCommand}"
                  CommandParameter="{Binding ModStorePath}"
                  IsEnabled="{Binding HasModStorePath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Open this directory in the file manager.">
                  <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button
                  Margin="0,4,0,0"
                  Command="{Binding CopyPathCommand}"
                  CommandParameter="{Binding ModStorePath}"
                  IsEnabled="{Binding HasModStorePath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Copy this path to the clipboard.">
                  <Path Data="{StaticResource IconClipboard}" Style="{StaticResource IconGlyph}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </GroupBox>

        <!--
          The workspace. It holds the vanilla copy, so a move while a profile is deployed
          would take the only way back. Both move commands refuse that case.

          The staging copy and the vanilla copy live in here, so the way to the other
          directories sits in this group. It sat beside Close until step 17, Part A, where
          it read as an action of the dialog and not as a destination.
        -->
        <GroupBox
          Margin="0,0,0,12"
          Padding="10"
          Header="Workspace">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock
                Style="{StaticResource Hint}"
                Text="{Binding WorkspaceStatus}"
                TextWrapping="Wrap" />
              <TextBox
                Style="{StaticResource PathBox}"
                Text="{Binding WorkspacePath, Mode=OneWay}"
                Visibility="{Binding HasWorkspacePath, Converter={StaticResource BoolToVisible}}" />
              <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Hint}"
                Text="A deploy builds here, then swaps the result into the game directory. Keep it on the volume of the game. The vanilla copy lives here, so revert before you move it."
                TextWrapping="Wrap" />
              <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                ui:Kind.Value="Quiet"
                Command="{Binding ShowFoldersCommand}"
                Content="Other directories"
                ToolTip="Open the staging copy, the vanilla copy, the application data, or the logs." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
              <Button
                Margin="0,0,0,4"
                HorizontalAlignment="Stretch"
                Command="{Binding SetWorkRootCommand}"
                Content="Change"
                ToolTip="Choose another directory for the workspace." />
              <Button
                Margin="0"
                HorizontalAlignment="Stretch"
                Command="{Binding UseDefaultWorkRootCommand}"
                Content="Use the default place"
                ToolTip="Put the workspace beside the game install again.">
                <Button.Style>
                  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WorkspaceIsDefault}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                  Command="{Binding OpenDirectoryCommand}"
                  CommandParameter="{Binding WorkspacePath}"
                  IsEnabled="{Binding HasWorkspacePath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Open this directory in the file manager.">
                  <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconGlyph}" />
                </Button>
                <Button
                  Margin="0,4,0,0"
                  Command="{Binding CopyPathCommand}"
                  CommandParameter="{Binding WorkspacePath}"
                  IsEnabled="{Binding HasWorkspacePath}"
                  Style="{StaticResource PathIconRow}"
                  ToolTip="Copy this path to the clipboard.">
                  <Path Data="{StaticResource IconClipboard}" Style="{StaticResource IconGlyph}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </GroupBox>

        <!--  The one deploy option that is not a path.  -->
        <GroupBox
          Margin="0,0,0,12"
          Padding="10"
          Header="Deploy">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Text="Full verify" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Hint}"
                Text="Hash every staged file after a deploy. Exact, but slow. Off compares name and length."
                TextWrapping="Wrap" />
            </StackPanel>
            <ToggleButton
              Grid.Column="1"
              VerticalAlignment="Top"
              IsChecked="{Binding FullVerify, Mode=TwoWay}"
              Style="{StaticResource TogglePill}" />
          </Grid>
        </GroupBox>

        <GroupBox
          Margin="0,0,0,12"
          Padding="10"
          Header="Binary mods">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Text="Deploy through Binary" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Hint}"
                Text="Route Binary mods through the Binary 2.8.3 install instead of the container engine. Binary writes in place, so every deploy copies the whole game directory. A mod can override this on its own row."
                TextWrapping="Wrap" />
            </StackPanel>
            <ToggleButton
              Grid.Column="1"
              VerticalAlignment="Top"
              IsChecked="{Binding BinaryRouteIsCli, Mode=TwoWay}"
              Style="{StaticResource TogglePill}" />
          </Grid>
        </GroupBox>

        <!--
          The look of the window. This group changes no deployed byte, and it is the only
          group here that does not.

          Three radio buttons and no toggle, because the answer holds three values. The two
          groups above hold two values each, and a TogglePill carries those. See
          docs/roadmap/18-hero-background.md.
        -->
        <GroupBox
          Margin="0,0,0,12"
          Padding="10"
          Header="Appearance">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Text="Background image" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Hint}"
                Text="The color of the selected game, behind the window. Corner puts it in the top left corner alone. Full spreads it across the whole window."
                TextWrapping="Wrap" />
            </StackPanel>
            <!--
              GroupName is not enough on its own here. Each button binds to a boolean of its
              own, and every one of those setters acts on true alone. See MainViewModel.
            -->
            <StackPanel
              Grid.Column="1"
              VerticalAlignment="Top"
              Orientation="Horizontal">
              <RadioButton
                Margin="0,0,10,0"
                Content="Off"
                GroupName="HeroBackground"
                IsChecked="{Binding HeroBackgroundIsOff, Mode=TwoWay}"
                ToolTip="Draw no image." />
              <RadioButton
                Margin="0,0,10,0"
                Content="Corner"
                GroupName="HeroBackground"
                IsChecked="{Binding HeroBackgroundIsCorner, Mode=TwoWay}"
                ToolTip="One accent in the top left corner, which fades out." />
              <RadioButton
                Content="Full"
                GroupName="HeroBackground"
                IsChecked="{Binding HeroBackgroundIsFull, Mode=TwoWay}"
                ToolTip="An even wash across the whole window." />
            </StackPanel>
          </Grid>
        </GroupBox>

        <!--
          Updates. The version sits here and in the status bar, and the log names it at every
          start. A user who reports a defect pastes that log.
        -->
        <GroupBox Padding="10" Header="Updates">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
              Grid.Row="0"
              Grid.Column="0"
              Margin="0,0,8,0">
              <TextBlock Text="{Binding VersionLabel}" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Hint}"
                Text="Get the newest release from GitHub and install it. The application restarts, and your mods, profiles, and settings survive."
                TextWrapping="Wrap" />
            </StackPanel>
            <Button
              Grid.Row="0"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Command="{Binding CheckForUpdatesCommand}"
              Content="Check now"
              ToolTip="Look for a newer release." />

            <StackPanel
              Grid.Row="1"
              Grid.Column="0"
              Margin="0,10,8,0">
              <TextBlock Text="Check at start" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Hint}"
                Text="Run that check at every start. Off reaches no network until you press the button."
                TextWrapping="Wrap" />
            </StackPanel>
            <ToggleButton
              Grid.Row="1"
              Grid.Column="1"
              Margin="0,10,0,0"
              VerticalAlignment="Top"
              IsChecked="{Binding CheckForUpdatesAtStart, Mode=TwoWay}"
              Style="{StaticResource TogglePill}" />
          </Grid>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

    <!--
      What the last Open or Copy path did. This window shows no status bar, and Open can
      fail on a Wine prefix that holds no file manager.
    -->
    <TextBlock
      Grid.Row="1"
      Margin="0,10,0,0"
      Style="{StaticResource Hint}"
      Text="{Binding SettingsReport}"
      TextWrapping="Wrap" />

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Button
        MinWidth="80"
        Margin="0"
        HorizontalAlignment="Right"
        Content="Close"
        IsCancel="True"
        IsDefault="True" />
    </Grid>
  </Grid>
</Window>
