<Window
  x:Class="BlackboxModManager.App.Views.ChoiceWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Blackbox Mod Manager"
  Width="620"
  Height="380"
  MinWidth="420"
  MinHeight="260"
  Background="{StaticResource SurfaceBase}"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      x:Name="Question"
      Grid.Row="0"
      Margin="0,0,0,10"
      TextWrapping="Wrap" />

    <!--
      A list and not a drop-down. Each row carries three facts about the file, and a
      drop-down would hide two of them until the user opens it.
    -->
    <ListBox
      x:Name="Choices"
      Grid.Row="1"
      HorizontalContentAlignment="Stretch"
      MouseDoubleClick="OnDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,4">
            <TextBlock
              FontWeight="Bold"
              Text="{Binding Title}"
              TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel
      Grid.Row="2"
      Margin="0,12,0,0"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        Click="OnAccept"
        Content="OK"
        IsDefault="True" />
      <Button
        Margin="0"
        Content="Cancel"
        IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
