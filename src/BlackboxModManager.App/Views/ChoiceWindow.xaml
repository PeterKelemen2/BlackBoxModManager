<Window x:Class="BlackboxModManager.App.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackbox Mod Manager" Width="620" Height="380" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="Question" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" />

    <!-- A list and not a drop-down. Each row carries three facts about the file, and a
         drop-down would hide two of them until the user opens it. -->
    <ListBox x:Name="Choices" Grid.Row="1" HorizontalContentAlignment="Stretch"
             MouseDoubleClick="OnDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,4">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.75" FontSize="11" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True" Click="OnAccept" />
      <Button Content="Cancel" IsCancel="True" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
