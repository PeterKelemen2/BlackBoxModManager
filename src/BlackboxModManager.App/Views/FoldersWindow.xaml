<Window
  x:Class="BlackboxModManager.App.Views.FoldersWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Folders"
  Width="820"
  Height="460"
  MinWidth="520"
  MinHeight="300"
  Background="{StaticResource SurfaceBase}"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Margin="0,0,0,10"
      Text="Every directory that this application reads or writes. Open opens the directory in the file manager of the platform. Copy path puts the path on the clipboard, which always works."
      TextWrapping="Wrap" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Rows">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource ListRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                  <TextBlock
                    Style="{StaticResource Hint}"
                    Text="{Binding Purpose}"
                    TextWrapping="Wrap" />
                  <!--  The path is selectable, so a user can copy part of it by hand.  -->
                  <TextBox
                    Margin="0,2,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="{Binding Path, Mode=OneWay}"
                    TextWrapping="Wrap" />
                  <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource Hint}"
                    Text="{Binding State}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                  Grid.Column="1"
                  VerticalAlignment="Top"
                  Orientation="Horizontal">
                  <Button
                    MinWidth="70"
                    Click="OnOpen"
                    Content="Open"
                    IsEnabled="{Binding Exists}"
                    Tag="{Binding}" />
                  <Button
                    MinWidth="90"
                    Margin="0"
                    Click="OnCopy"
                    Content="Copy path"
                    Tag="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="Report"
        Grid.Column="0"
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Style="{StaticResource Hint}"
        TextWrapping="Wrap" />
      <Button
        Grid.Column="1"
        MinWidth="80"
        Margin="0"
        Content="Close"
        IsCancel="True"
        IsDefault="True" />
    </Grid>
  </Grid>
</Window>
