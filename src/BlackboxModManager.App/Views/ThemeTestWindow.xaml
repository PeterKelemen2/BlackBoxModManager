<Window
  x:Class="BlackboxModManager.App.Views.ThemeTestWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:BlackboxModManager.App.Theme"
  Title="Theme test"
  Width="900"
  Height="700"
  Background="{StaticResource SurfaceBase}">
  <!--
    Every control, in every mode, in every state: resting, hover, pressed, disabled,
    focused, and selected. One Wine run checks the whole theme. Hover and pressed do
    not show as a fixed state here, so look at those two by hand under Wine.
  -->
  <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Buttons" />
      <WrapPanel Margin="0,0,0,16">
        <Button Content="Default" />
        <Button ui:Kind.Value="Primary" Content="Primary" />
        <Button ui:Kind.Value="Success" Content="Success" />
        <Button ui:Kind.Value="Danger" Content="Danger" />
        <Button ui:Kind.Value="Quiet" Content="Quiet" />
        <Button Content="Disabled" IsEnabled="False" />
        <Button
          ui:Kind.Value="Primary"
          Content="Disabled Primary"
          IsEnabled="False" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Text boxes" />
      <WrapPanel Margin="0,0,0,16">
        <TextBox
          Width="140"
          Margin="0,0,8,0"
          Text="Resting" />
        <TextBox
          Width="160"
          Margin="0,0,8,0"
          Text="Focused (tab to me)" />
        <TextBox
          Width="140"
          Margin="0,0,8,0"
          IsReadOnly="True"
          Text="Read-only" />
        <TextBox
          Width="120"
          IsEnabled="False"
          Text="Disabled" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Check boxes" />
      <WrapPanel Margin="0,0,0,16">
        <CheckBox Margin="0,0,16,0" Content="Unchecked" />
        <CheckBox
          Margin="0,0,16,0"
          Content="Checked"
          IsChecked="True" />
        <CheckBox
          Margin="0,0,16,0"
          Content="Disabled"
          IsEnabled="False" />
        <CheckBox
          Content="Disabled, checked"
          IsChecked="True"
          IsEnabled="False" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Toggle pills" />
      <WrapPanel Margin="0,0,0,16">
        <ToggleButton Margin="0,0,16,0" Style="{StaticResource TogglePill}" />
        <ToggleButton
          Margin="0,0,16,0"
          IsChecked="True"
          Style="{StaticResource TogglePill}" />
        <ToggleButton
          Margin="0,0,16,0"
          IsEnabled="False"
          Style="{StaticResource TogglePill}" />
        <ToggleButton
          IsChecked="True"
          IsEnabled="False"
          Style="{StaticResource TogglePill}" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Combo box" />
      <ComboBox
        Width="200"
        Margin="0,0,0,16"
        HorizontalAlignment="Left">
        <ComboBoxItem Content="First option" IsSelected="True" />
        <ComboBoxItem Content="Second option" />
        <ComboBoxItem Content="Third option" />
      </ComboBox>

      <TextBlock Style="{StaticResource Heading}" Text="Tabs" />
      <TabControl Height="120" Margin="0,0,0,16">
        <TabItem Header="One">
          <TextBlock Margin="8" Text="The body of the first tab." />
        </TabItem>
        <TabItem Header="Two">
          <TextBlock Margin="8" Text="The body of the second tab." />
        </TabItem>
      </TabControl>

      <TextBlock Style="{StaticResource Heading}" Text="List box" />
      <ListBox Height="90" Margin="0,0,0,16">
        <ListBoxItem Content="Resting row" />
        <ListBoxItem Content="Selected row" IsSelected="True" />
        <ListBoxItem Content="Another row" />
      </ListBox>

      <TextBlock Style="{StaticResource Heading}" Text="Card (GroupBox)" />
      <GroupBox
        Margin="0,0,0,16"
        Padding="8"
        Header="A card header">
        <TextBlock Text="The body of the card." ToolTip="A tooltip over the card body." />
      </GroupBox>

      <TextBlock Style="{StaticResource Heading}" Text="Grid splitter" />
      <Grid Height="40" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}" />
        <GridSplitter
          Grid.Column="1"
          Width="6"
          HorizontalAlignment="Stretch" />
        <Border Grid.Column="2" Background="{StaticResource SurfaceRaised}" />
      </Grid>

    </StackPanel>
  </ScrollViewer>
</Window>
