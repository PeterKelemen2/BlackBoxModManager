<Window
  x:Class="BlackboxModManager.App.Views.ThemeTestWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:BlackboxModManager.App.Theme"
  Title="Theme test"
  Width="900"
  Height="700"
  Background="{StaticResource SurfaceBase}">
  <!--
    Every control, in every mode, in every state: resting, hover, pressed, disabled,
    focused, and selected. One Wine run checks the whole theme. Hover and pressed do
    not show as a fixed state here, so look at those two by hand under Wine.
  -->
  <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Buttons" />
      <WrapPanel Margin="0,0,0,16">
        <Button Content="Default" />
        <Button ui:Kind.Value="Primary" Content="Primary" />
        <Button ui:Kind.Value="Success" Content="Success" />
        <Button ui:Kind.Value="Danger" Content="Danger" />
        <Button ui:Kind.Value="Quiet" Content="Quiet" />
        <Button Content="Disabled" IsEnabled="False" />
        <Button
          ui:Kind.Value="Primary"
          Content="Disabled Primary"
          IsEnabled="False" />
      </WrapPanel>

      <!--
        The two outlined modes of step 12. Success and Danger above keep their solid fill,
        because ConfirmWindow paints a destructive answer with Danger.
      -->
      <TextBlock Style="{StaticResource Heading}" Text="Outlined buttons" />
      <WrapPanel Margin="0,0,0,16">
        <Button ui:Kind.Value="SuccessOutline" Content="Deploy" />
        <Button ui:Kind.Value="DangerOutline" Content="Revert to vanilla" />
        <Button
          ui:Kind.Value="SuccessOutline"
          Content="Disabled"
          IsEnabled="False" />
        <Button
          ui:Kind.Value="DangerOutline"
          Content="Disabled"
          IsEnabled="False" />
      </WrapPanel>

      <!--
        The icon buttons. Every glyph is Path geometry from Theme/Icons.xaml, because a
        glyph font that the machine does not hold kills the process under Wine.

        The disabled pair is the check that matters. IconGlyph binds its stroke to the
        Foreground of the button, so a disabled glyph has to dim with its label.
      -->
      <TextBlock Style="{StaticResource Heading}" Text="Icon buttons" />
      <WrapPanel Margin="0,0,0,16">
        <Button Style="{StaticResource IconButton}" ToolTip="Plus">
          <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconGlyph}" />
        </Button>
        <Button Style="{StaticResource IconButton}" ToolTip="Chevron up">
          <Path Data="{StaticResource IconChevronUp}" Style="{StaticResource IconGlyph}" />
        </Button>
        <Button Style="{StaticResource IconButton}" ToolTip="Chevron down">
          <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource IconGlyph}" />
        </Button>
        <Button
          ui:Kind.Value="DangerOutline"
          Style="{StaticResource IconButton}"
          ToolTip="Trash">
          <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconGlyph}" />
        </Button>
        <Button
          ui:Kind.Value="Quiet"
          Style="{StaticResource IconButton}"
          ToolTip="Settings">
          <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconGlyph}" />
        </Button>
        <Button
          ui:Kind.Value="Quiet"
          Style="{StaticResource IconButton}"
          ToolTip="More">
          <Path Data="{StaticResource IconMore}" Style="{StaticResource IconGlyph}" />
        </Button>
        <Button
          Margin="16,0,6,0"
          IsEnabled="False"
          Style="{StaticResource IconButton}"
          ToolTip="Disabled chevron down">
          <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource IconGlyph}" />
        </Button>
        <Button
          ui:Kind.Value="DangerOutline"
          IsEnabled="False"
          Style="{StaticResource IconButton}"
          ToolTip="Disabled trash">
          <Path Data="{StaticResource IconTrash}" Style="{StaticResource IconGlyph}" />
        </Button>
      </WrapPanel>

      <!--
        The menu. A menu popup is a layered window, and a hardware popup paints black under
        Wine. Rendering.Apply forces software rendering there. Right-click the block below
        to check that this holds for a menu and not only for a combo box.
      -->
      <TextBlock Style="{StaticResource Heading}" Text="Menu" />
      <Border
        Height="60"
        Margin="0,0,0,16"
        Background="{StaticResource SurfaceRaised}"
        BorderBrush="{StaticResource BorderDefault}"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusCard}">
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Style="{StaticResource Hint}"
          Text="Right-click here to open a menu." />
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="First item" />
            <MenuItem Header="Second item" />
            <Separator />
            <MenuItem Header="Disabled item" IsEnabled="False" />
          </ContextMenu>
        </Border.ContextMenu>
      </Border>

      <TextBlock Style="{StaticResource Heading}" Text="Text boxes" />
      <WrapPanel Margin="0,0,0,16">
        <TextBox
          Width="140"
          Margin="0,0,8,0"
          Text="Resting" />
        <TextBox
          Width="160"
          Margin="0,0,8,0"
          Text="Focused (tab to me)" />
        <TextBox
          Width="140"
          Margin="0,0,8,0"
          IsReadOnly="True"
          Text="Read-only" />
        <TextBox
          Width="120"
          IsEnabled="False"
          Text="Disabled" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Check boxes" />
      <WrapPanel Margin="0,0,0,16">
        <CheckBox Margin="0,0,16,0" Content="Unchecked" />
        <CheckBox
          Margin="0,0,16,0"
          Content="Checked"
          IsChecked="True" />
        <CheckBox
          Margin="0,0,16,0"
          Content="Disabled"
          IsEnabled="False" />
        <CheckBox
          Content="Disabled, checked"
          IsChecked="True"
          IsEnabled="False" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Toggle pills" />
      <WrapPanel Margin="0,0,0,16">
        <ToggleButton Margin="0,0,16,0" Style="{StaticResource TogglePill}" />
        <ToggleButton
          Margin="0,0,16,0"
          IsChecked="True"
          Style="{StaticResource TogglePill}" />
        <ToggleButton
          Margin="0,0,16,0"
          IsEnabled="False"
          Style="{StaticResource TogglePill}" />
        <ToggleButton
          IsChecked="True"
          IsEnabled="False"
          Style="{StaticResource TogglePill}" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Combo box" />
      <ComboBox
        Width="200"
        Margin="0,0,0,16"
        HorizontalAlignment="Left">
        <ComboBoxItem Content="First option" IsSelected="True" />
        <ComboBoxItem Content="Second option" />
        <ComboBoxItem Content="Third option" />
      </ComboBox>

      <TextBlock Style="{StaticResource Heading}" Text="Tabs" />
      <TabControl Height="130" Margin="0,0,0,16">
        <TabItem Header="One">
          <TextBlock Margin="8" Text="The body of the first tab. The strip sits inside this card." />
        </TabItem>
        <TabItem Header="Two">
          <TextBlock Margin="8" Text="The body of the second tab." />
        </TabItem>
        <TabItem Header="Three">
          <TextBlock Margin="8" Text="The body of the third tab." />
        </TabItem>
      </TabControl>

      <TextBlock Style="{StaticResource Heading}" Text="List box" />
      <ListBox Height="90" Margin="0,0,0,16">
        <ListBoxItem Content="Resting row" />
        <ListBoxItem Content="Selected row" IsSelected="True" />
        <ListBoxItem Content="Another row" />
      </ListBox>

      <TextBlock Style="{StaticResource Heading}" Text="Card (GroupBox)" />
      <GroupBox
        Margin="0,0,0,8"
        Padding="8"
        Header="A card header">
        <TextBlock Text="The body of the card." ToolTip="A tooltip over the card body." />
      </GroupBox>

      <!--  A card with no Header hides the header row. The mod list card depends on that.  -->
      <GroupBox Margin="0,0,0,16" Padding="8">
        <TextBlock Text="A card with no header. The body starts at the top edge." />
      </GroupBox>

      <TextBlock Style="{StaticResource Heading}" Text="The plus of the empty mod list" />
      <WrapPanel Margin="0,0,0,16">
        <Button Margin="0,0,16,0" Style="{StaticResource AddModButton}" />
        <Button IsEnabled="False" Style="{StaticResource AddModButton}" />
      </WrapPanel>

      <TextBlock Style="{StaticResource Heading}" Text="Grid splitter" />
      <Grid Height="40" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}" />
        <GridSplitter
          Grid.Column="1"
          Width="6"
          HorizontalAlignment="Stretch" />
        <Border Grid.Column="2" Background="{StaticResource SurfaceRaised}" />
      </Grid>

    </StackPanel>
  </ScrollViewer>
</Window>
