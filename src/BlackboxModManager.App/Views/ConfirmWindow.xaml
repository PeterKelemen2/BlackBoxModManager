<Window
  x:Class="BlackboxModManager.App.Views.ConfirmWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="BlackBox Mod Manager"
  Width="460"
  MaxWidth="620"
  Background="{StaticResource SurfaceBase}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <TextBlock
      x:Name="Question"
      Margin="0,0,0,16"
      TextWrapping="Wrap" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
      <!--
        No holds the focus, and it is the cancel button. A destructive question must not
        answer itself when the user presses Enter. See docs/roadmap/11-ui-polish.md, Part A.
      -->
      <Button
        x:Name="ConfirmButton"
        MinWidth="100"
        Click="OnConfirm"
        Content="Yes" />
      <Button
        x:Name="CancelButton"
        MinWidth="80"
        Margin="0"
        Content="No"
        IsCancel="True"
        IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
