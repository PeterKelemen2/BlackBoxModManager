<Window
  x:Class="BlackboxModManager.App.Views.TextPromptWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Blackbox Mod Manager"
  Width="420"
  Background="{StaticResource SurfaceBase}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <TextBlock
      x:Name="Question"
      Margin="0,0,0,8"
      TextWrapping="Wrap" />
    <TextBox
      x:Name="Answer"
      Margin="0,0,0,16"
      KeyDown="OnKeyDown" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
      <Button
        Click="OnAccept"
        Content="OK"
        IsDefault="True" />
      <Button
        Margin="0"
        Content="Cancel"
        IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
