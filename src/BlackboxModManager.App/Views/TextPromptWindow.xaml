<Window x:Class="BlackboxModManager.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackbox Mod Manager" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock x:Name="Question" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox x:Name="Answer" Margin="0,0,0,16" KeyDown="OnKeyDown" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="OK" IsDefault="True" Click="OnAccept" />
      <Button Content="Cancel" IsCancel="True" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
