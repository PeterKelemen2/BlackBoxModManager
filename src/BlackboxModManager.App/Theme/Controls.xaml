<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:BlackboxModManager.App.Theme">

  <!--
    One style per built-in control. Read docs/roadmap/10-dark-theme.md, Part C, before
    you touch this file. State triggers live in ControlTemplate.Triggers, never in
    Style.Triggers, so that a TemplateBinding never loses against a Style setter.
  -->

  <!--
    The window. This applies to every Window, including every dialog of Part F, because
    Application.Resources merges this dictionary. A dialog does not need to repeat it.
  -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <!--  The button. Four modes, one template.  -->
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Chrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusDefault}">
            <ContentPresenter
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Default" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Default" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfacePressed}" />
            </MultiTrigger>

            <Trigger Property="ui:Kind.Value" Value="Primary">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDefault}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentDefault}" />
              <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Primary" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Primary" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressed}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentPressed}" />
            </MultiTrigger>

            <Trigger Property="ui:Kind.Value" Value="Success">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SuccessDefault}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SuccessDefault}" />
              <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Success" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SuccessHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SuccessHover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Success" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SuccessPressed}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SuccessPressed}" />
            </MultiTrigger>

            <Trigger Property="ui:Kind.Value" Value="Danger">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerDefault}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerDefault}" />
              <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Danger" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerHover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Danger" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerPressed}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerPressed}" />
            </MultiTrigger>

            <!--  A Quiet button carries no fill until the pointer enters it.  -->
            <Trigger Property="ui:Kind.Value" Value="Quiet">
              <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Quiet" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ui:Kind.Value" Value="Quiet" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfacePressed}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaised}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The text box. Rounded border, focus border, a dimmer fill for the read-only variant.  -->
  <Style TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentDefault}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border
            x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource RadiusDefault}">
            <ScrollViewer
              x:Name="PART_ContentHost"
              Margin="{TemplateBinding Padding}"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceOverlay}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The check box. A drawn check mark, never a glyph font.  -->
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border
              x:Name="Box"
              Width="16"
              Height="16"
              VerticalAlignment="Center"
              Background="{StaticResource SurfaceRaised}"
              BorderBrush="{StaticResource BorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusSmall}">
              <!--
                The geometry starts at the origin, and the path centers itself. The default
                Stretch is None, so the layout box of a path runs from the origin to the far
                end of its geometry. A geometry that starts at 3,8 therefore pushes the mark
                down and to the right, and the right tip then touches the border. Do not use
                Stretch="Uniform" here. It scales a stroked geometry by rules that are hard
                to predict at 14 pixels. See docs/roadmap/11-ui-polish.md, Part C.
              -->
              <Path
                x:Name="Check"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M 0,3.5 L 3.5,7 L 9.5,0"
                Stroke="{StaticResource OnAccent}"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2"
                Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDefault}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDefault}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The toggle pill. It carries a key on purpose, because ComboBoxToggleButtonStyle is a
    ToggleButton too and the combo box template names it. An implicit style for
    ToggleButton would reach the arrow of every combo box. See
    docs/roadmap/11-ui-polish.md, Part D.

    The knob moves with a TranslateTransform and never with a margin. A render transform
    marks one small rectangle dirty and runs no layout pass, so it costs almost nothing on
    the software rasterizer of Wine. A Thickness animation would lay the row out again on
    every frame.
  -->
  <Style x:Key="TogglePill" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Track"
            Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="10">
            <Border
              x:Name="Knob"
              Width="14"
              Height="14"
              Margin="3,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{StaticResource TextSecondary}"
              CornerRadius="7">
              <Border.RenderTransform>
                <TranslateTransform x:Name="KnobShift" X="0" />
              </Border.RenderTransform>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentDefault}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentDefault}" />
              <Setter TargetName="Knob" Property="Background" Value="{StaticResource OnAccent}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="KnobShift"
                      Storyboard.TargetProperty="X"
                      To="14"
                      Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="KnobShift"
                      Storyboard.TargetProperty="X"
                      To="0"
                      Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource SurfaceHover}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHover}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentHover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource SurfacePressed}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentPressed}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentPressed}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            </Trigger>
            <!--
              A disabled pill still has to read as on or as off. The two states therefore
              need two triggers. One IsEnabled trigger would set one fill over both, and a
              locked pill would then look off whatever it holds. There is no muted accent
              token, so the on state borrows BorderStrong.
            -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource SurfaceRaised}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BorderDefault}" />
              <Setter TargetName="Knob" Property="Background" Value="{StaticResource TextDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{StaticResource BorderStrong}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
              <Setter TargetName="Knob" Property="Background" Value="{StaticResource TextDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The combo box. The toggle, the arrow, the popup, and the item. The popup keeps a
    full opaque fill under its rounded corners. See the pitfalls section of Part C.
  -->
  <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Border"
            Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusDefault}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
              </Grid.ColumnDefinitions>
              <Path
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M 0,0 L 4,5 L 8,0"
                Stroke="{StaticResource TextSecondary}"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="1.5" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
            x:Name="Border"
            Padding="{TemplateBinding Padding}"
            Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfacePressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton
              x:Name="Toggle"
              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
              Style="{StaticResource ComboBoxToggleButtonStyle}" />
            <ContentPresenter
              x:Name="Content"
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Content="{TemplateBinding SelectionBoxItem}"
              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
              IsHitTestVisible="False" />
            <Popup
              x:Name="Popup"
              AllowsTransparency="True"
              Focusable="False"
              IsOpen="{TemplateBinding IsDropDownOpen}"
              Placement="Bottom"
              PopupAnimation="None">
              <Border
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                MaxHeight="300"
                Background="{StaticResource SurfaceOverlay}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusDefault}">
                <ScrollViewer Margin="2">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The tab strip. The strip sits inside the card of the TabControl below, so a tab draws no
    edge of its own. The selected tab draws an AccentDefault block with OnAccent text. An
    unselected tab shows TextSecondary and no fill, and it takes a SurfaceHover block under
    the pointer.

    The block takes RadiusDefault corners. A full radius turns a short header such as Mod or
    Log into an oval, because a Border clamps the radius to half of its shorter side.

    The IsSelected trigger comes after the IsMouseOver trigger on purpose. A later trigger
    wins, so the selected pill keeps its accent fill while the pointer rests on it.
  -->
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Padding" Value="14,5" />
    <!--
      The gap between two pills. The items host of the TabControl below must stay a
      WrapPanel for this margin to survive. Read the comment there before you change either
      one.
    -->
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border
            x:Name="Pill"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{StaticResource RadiusDefault}">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource SurfaceHover}" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentDefault}" />
              <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The card of the right panel. The tab strip sits inside this card, above the body, and the
    card carries RadiusCard corners. That is the same radius as the GroupBox card below, so
    the mod list and this panel match across the splitter. Change both together.
  -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Border
            Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <!--
                A WrapPanel holds the headers, and never a TabPanel.

                <b>TabPanel cuts the right margin off the header that carries it.</b> It
                measures a header at the full desired width, margin included, and it then
                places the next header at that width. The header draws wider than the space
                that it gets, and the right edge disappears. A 4 pixel margin took the whole
                right corner radius of the pill, so the pill showed two round corners and two
                square ones.

                A WrapPanel arranges the same headers correctly, and it wraps to a second row
                when the splitter makes this panel narrow. TabPanel wraps as well, so this
                swap loses nothing.
              -->
              <WrapPanel
                Grid.Row="0"
                Margin="6,6,6,2"
                Background="Transparent"
                IsItemsHost="True" />
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The log, the conflict list, and the choice dialog.  -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            x:Name="Border"
            Padding="{TemplateBinding Padding}"
            Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfacePressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The scrollbar. A default scrollbar is the loudest light element left.  -->
  <Style x:Key="ThemeScrollBarThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{StaticResource BorderStrong}" CornerRadius="{StaticResource RadiusSmall}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemeScrollBarRepeatButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ThemeScrollBarRepeatButton}" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ThemeScrollBarRepeatButton}" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb
                Width="6"
                Height="6"
                Style="{StaticResource ThemeScrollBarThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--
    The card. One style replaces every GroupBox in the window.

    A GroupBox with no Header hides the header row and shows the body alone. The mod list
    card depends on that. Without the trigger, the empty header still takes its margin, and
    the card then starts 4 pixels lower than the tab card beside it.
  -->
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter
              x:Name="HeaderHost"
              Grid.Row="0"
              Margin="2,0,0,4"
              ContentSource="Header">
              <ContentPresenter.Resources>
                <Style BasedOn="{StaticResource Heading}" TargetType="TextBlock" />
              </ContentPresenter.Resources>
            </ContentPresenter>
            <Border
              Grid.Row="1"
              Padding="{TemplateBinding Padding}"
              Background="{StaticResource SurfaceRaised}"
              BorderBrush="{StaticResource BorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusCard}">
              <ContentPresenter />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
              <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The ? marker of the settings panel depends on this.  -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource RadiusDefault}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The bottom line.  -->
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="StatusBar">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    A hit area with no line. The splitter drags and it draws nothing. The two cards on each
    side already separate the panels, so a line between them adds a third edge.

    The rectangle carries a transparent fill and never a null fill. A transparent fill
    answers a hit test and a null fill does not, so a null fill would leave the splitter
    undraggable. The control sets the resize cursor itself, and that cursor is the only
    signal that the gap takes a drag.
  -->
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
