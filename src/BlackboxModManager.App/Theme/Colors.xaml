<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

     <!--
          One name per role, never per value. Every color of the window is a key of this
          file. A later light theme needs one new file like this one and no other change.
     -->

     <SolidColorBrush x:Key="SurfaceBase" Color="#16181D" />
     <SolidColorBrush x:Key="SurfaceRaised" Color="#1E2127" />
     <SolidColorBrush x:Key="SurfaceOverlay" Color="#262A32" />
     <SolidColorBrush x:Key="SurfaceHover" Color="#2E333D" />
     <SolidColorBrush x:Key="SurfacePressed" Color="#383E4A" />

     <SolidColorBrush x:Key="BorderDefault" Color="#333944" />
     <SolidColorBrush x:Key="BorderStrong" Color="#4A5261" />

     <SolidColorBrush x:Key="TextPrimary" Color="#E6E9EF" />
     <SolidColorBrush x:Key="TextSecondary" Color="#A0A8B6" />
     <SolidColorBrush x:Key="TextDisabled" Color="#6B7280" />

     <SolidColorBrush x:Key="AccentDefault" Color="#4C8DFF" />
     <SolidColorBrush x:Key="AccentHover" Color="#669EFF" />
     <SolidColorBrush x:Key="AccentPressed" Color="#3A78E0" />

     <!--
          SurfaceRaised with its alpha lowered. The mod-list card and the tab strip's card
          use this instead of SurfaceRaised, so the hero image (MainWindow.xaml) shows
          through wherever a card sits over it. That image is the corner accent or the full
          wash, whichever look the settings hold. This is the one deliberate exception
          to "drop Opacity as a color tool" below — the two cards it applies to redraw
          rarely, not per frame, and the alpha sits on the fill alone, so a border and its
          text stay crisp.
     -->
     <SolidColorBrush x:Key="SurfaceRaisedTranslucent" Color="#BF1E2127" />

     <SolidColorBrush x:Key="SuccessDefault" Color="#3FB950" />
     <SolidColorBrush x:Key="SuccessHover" Color="#57C767" />
     <SolidColorBrush x:Key="SuccessPressed" Color="#2F9C3E" />

     <SolidColorBrush x:Key="DangerDefault" Color="#E5534B" />
     <SolidColorBrush x:Key="DangerHover" Color="#F0665E" />
     <SolidColorBrush x:Key="DangerPressed" Color="#C7423B" />

     <!--
          The fill of an outlined button under the pointer. Both sit near SurfaceRaised
          (#1E2127) and carry a trace of the color of the role. They are surfaces and not
          accents, so no text ever reads against one alone.

          These two tokens exist because a hover state cannot use Opacity. Step 10, Part A,
          bans Opacity as a color tool, and the software rasterizer of Wine composites an
          alpha value on every repaint.
     -->
     <SolidColorBrush x:Key="SuccessSubtle" Color="#1B2C1F" />
     <SolidColorBrush x:Key="DangerSubtle" Color="#2C1D1D" />

     <SolidColorBrush x:Key="WarningDefault" Color="#D29922" />

     <SolidColorBrush x:Key="OnAccent" Color="#0B0D11" />

</ResourceDictionary>
