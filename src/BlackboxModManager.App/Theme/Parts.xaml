<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The application parts. Read docs/roadmap/10-dark-theme.md, Part E, before you touch
    this file.
  -->

  <!--
    The variant list, the loader list, and the folder list all used the same
    "#40808080" bottom border. This one style replaces every one of them.
  -->
  <Style x:Key="ListRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,6" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!--
    The ? marker of the settings panel. A round Quiet glyph with a hover fill, never a
    glyph font.
  -->
  <Style x:Key="HelpMarker" TargetType="Border">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Help" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="HelpMarkerGlyph" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!--
    The plus of the empty mod list. A square card with a drawn cross, big enough to read as
    the one thing to press in an empty panel.

    The cross is Path geometry and never a glyph font. Step 10, fact 9, holds here. A named
    glyph family that the machine does not hold reaches MS.Internal.Invariant.FailFast, and
    that kills the process with no dialog.
  -->
  <Style x:Key="AddModButton" TargetType="Button">
    <Setter Property="Width" Value="76" />
    <Setter Property="Height" Value="76" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Face"
            Background="{StaticResource SurfaceOverlay}"
            BorderBrush="{StaticResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}">
            <Path
              x:Name="Cross"
              Width="28"
              Height="28"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="M 0,14 L 28,14 M 14,0 L 14,28"
              Stroke="{StaticResource TextSecondary}"
              StrokeEndLineCap="Round"
              StrokeStartLineCap="Round"
              StrokeThickness="2" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentDefault}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentDefault}" />
              <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource OnAccent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentPressed}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentPressed}" />
              <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource OnAccent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentDefault}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceRaised}" />
              <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource BorderDefault}" />
              <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The glyph inside an icon button. The geometry comes from Theme/Icons.xaml. See
    docs/roadmap/12-minimal-ui.md, Part B.

    <b>The stroke reads the Foreground of the button that holds it.</b> That one binding
    gives every icon its disabled color and both outlined colors for free. The Button
    template in Controls.xaml sets Foreground on the button for the disabled state and for
    every Kind, so the glyph follows with no trigger of its own.

    The style sets no Stretch. The default is None, and the geometry already carries its true
    size. Do not add Stretch="Uniform". WPF scales a stroked geometry by rules that are hard
    to predict at 13 pixels. See docs/roadmap/11-ui-polish.md, Part C.
  -->
  <Style x:Key="IconGlyph" TargetType="Path">
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!--  The chrome of the button answers the hit test. The glyph never needs to.  -->
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!--
    A square button that holds one glyph and no label.

    <b>MinWidth must go back to zero.</b> The implicit Button style holds MinWidth 80, and an
    icon button without this setter draws as a wide slab with a small mark in the middle.

    Every icon button needs a ToolTip. The label is gone, so the tooltip is the only name
    that the control has.
  -->
  <Style
    x:Key="IconButton"
    BasedOn="{StaticResource {x:Type Button}}"
    TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!--
    An icon button beside a line of hint text. The full size button reads as a slab next to
    an 11 pixel line, so this one is 20 pixels.

    Every rule of IconButton holds here. The tooltip is the only name that the control has.
  -->
  <Style
    x:Key="IconButtonSmall"
    BasedOn="{StaticResource IconButton}"
    TargetType="Button">
    <Setter Property="Width" Value="{StaticResource ControlHeightSmall}" />
    <Setter Property="Height" Value="{StaticResource ControlHeightSmall}" />
  </Style>

  <!--
    The spinner of a button that runs a long operation.

    The control starts collapsed, so an idle button carries no gap and no mark. The button
    grows by the width of the spinner when its operation starts. That growth is the point.
    A reserved gap sits in both buttons at all times and says nothing.

    A collapsed control also stops the turn, because IsVisible reads false for it.

    <b>The turn is a Control template and never a Style setter on a Path.</b> WPF freezes a
    Freezable that a Setter holds, and an animation of a frozen RotateTransform throws. A
    template builds one transform for each instance, so the two buttons of the window can
    both carry one of these.

    The turn steps 45 degrees eight times per second. A continuous turn asks the software
    rasterizer of Wine for a repaint on every frame, and this reads the same for much less
    work. See docs/roadmap/10-dark-theme.md, Part E.

    The arc takes AccentDefault and never the Foreground of the button. A button grays out
    while its operation runs, and a spinner in TextDisabled is the one part of that button
    that still has to catch the eye.
  -->
  <Style x:Key="Spinner" TargetType="Control">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Foreground" Value="{StaticResource AccentDefault}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Path
            Width="14"
            Height="14"
            Data="{StaticResource IconSpinnerArc}"
            RenderTransformOrigin="0.5,0.5"
            Stroke="{TemplateBinding Foreground}"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="2">
            <Path.RenderTransform>
              <RotateTransform x:Name="Turner" Angle="0" />
            </Path.RenderTransform>
          </Path>
          <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Turn">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames
                      RepeatBehavior="Forever"
                      Storyboard.TargetName="Turner"
                      Storyboard.TargetProperty="Angle"
                      Duration="0:0:0.8">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="45" />
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="90" />
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="135" />
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="180" />
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="225" />
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="270" />
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.7" Value="315" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Turn" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  The log. IBM Plex Sans, because a log line and a conflict line carry no heading.  -->
  <Style x:Key="LogLine" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LogFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--  A conflict line reads in WarningDefault.  -->
  <Style
    x:Key="ConflictLine"
    BasedOn="{StaticResource LogLine}"
    TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WarningDefault}" />
  </Style>

  <!--
    The drag handle of the mod row. Three short dashes, drawn with Path geometry.

    The style sets no cursor. A path answers a hit test only where it paints, so the cursor
    over these three 1.5 pixel lines changed on every 2.5 pixel gap between them. The row
    carries the cursor now, and DragHandleArea below carries the hit area.
  -->
  <Style x:Key="DragHandle" TargetType="Path">
    <Setter Property="Data" Value="M 0,0 L 10,0 M 0,4 L 10,4 M 0,8 L 10,8" />
    <Setter Property="Stroke" Value="{StaticResource TextSecondary}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    The hit area around the handle. A transparent fill answers a hit test and a null fill
    does not, so this border makes the whole block of the icon one target. The icon is 10 by
    8 pixels and the target is 26 wide and the full height of the row.
  -->
  <Style x:Key="DragHandleArea" TargetType="Border">
    <Setter Property="Width" Value="26" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!--
    The bar of an import row.

    The template names PART_Track and PART_Indicator. ProgressBar sets the width of the
    indicator from those two names, and a template without them draws a bar that never
    moves. The track clips, so the round corner of the indicator stays inside the track.
  -->
  <Style x:Key="ImportProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Foreground" Value="{StaticResource AccentDefault}" />
    <Setter Property="Background" Value="{StaticResource SurfacePressed}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSmall}">
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border
                x:Name="PART_Indicator"
                HorizontalAlignment="Left"
                Background="{TemplateBinding Foreground}"
                CornerRadius="{StaticResource RadiusSmall}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The row of an import that still runs. It carries the accent edge, so it reads as the
    one row of the list that is not a mod yet.

    The row holds no drag handle, no toggle, and no menu. An import is not a mod until the
    store holds it, and none of those three actions has anything to act on. The name of
    this template is not RowBorder for the same reason. FindRowElement in
    MainWindow.xaml.cs matches that exact name, and a match here would arm a drag on a row
    that carries no mod.
  -->
  <DataTemplate x:Key="ImportRowTemplate">
    <Border
      MinHeight="{StaticResource ModRowHeight}"
      Margin="0,0,0,6"
      Padding="8,6"
      Background="{StaticResource SurfaceRaised}"
      BorderBrush="{StaticResource AccentDefault}"
      BorderThickness="1"
      CornerRadius="{StaticResource RadiusDefault}">
      <StackPanel VerticalAlignment="Center">
        <TextBlock
          FontFamily="{StaticResource UiFontFamilyStrong}"
          FontWeight="SemiBold"
          Foreground="{StaticResource TextPrimary}"
          Text="{Binding Name}"
          TextWrapping="Wrap" />
        <TextBlock
          Style="{StaticResource Hint}"
          Text="{Binding Line}"
          TextTrimming="CharacterEllipsis"
          TextWrapping="NoWrap" />
        <ProgressBar
          x:Name="Bar"
          Margin="0,6,0,0"
          Style="{StaticResource ImportProgressBar}"
          Value="{Binding Percent, Mode=OneWay}" />
      </StackPanel>
    </Border>
    <DataTemplate.Triggers>
      <!--  A step that counts no file draws no bar. A bar at zero reads as a dead import.  -->
      <DataTrigger Binding="{Binding HasBar}" Value="False">
        <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--
    The row of the mod list. A SurfaceRaised fill, RadiusDefault corners, a BorderDefault
    edge.

    Step 10 drew an insertion line from two 2 pixel borders of this template, and step 11
    removed both. The dragged row now travels inside the collection to the place where the
    drop lands, and it draws as the ghost of that slot. See docs/roadmap/11-ui-polish.md,
    Part B. MinHeight holds every row at one height, so the ghost reads as a slot.

    RowBorder is a name that code reads. FindRowElement in MainWindow.xaml.cs matches that
    exact string to find the row under the pointer. A rename here kills the drag, the drop,
    and the row selection, and the build reports nothing.
  -->
  <DataTemplate x:Key="ModRowTemplate">
    <Border
      x:Name="RowBorder"
      MinHeight="{StaticResource ModRowHeight}"
      Margin="0,0,0,6"
      Padding="8,6"
      Background="{StaticResource SurfaceRaised}"
      Cursor="SizeAll"
      BorderBrush="{StaticResource BorderDefault}"
      BorderThickness="1"
      CornerRadius="{StaticResource RadiusDefault}"
      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
      <!--
        The two mod actions that the toolbar does not hold. See
        docs/roadmap/12-minimal-ui.md, Part E.

        <b>A ContextMenu is not in the visual tree of the window</b>, so a binding with
        RelativeSource AncestorType=Window finds nothing here. Tag above carries the
        MainViewModel across that gap, and the menu takes it as its own DataContext. Every
        item below then binds to a command by name.

        The row itself carries the ModRowViewModel, so Tag is the only way through.

        <b>ModList_PreviewMouseRightButtonDown selects the row before this opens.</b> Without
        that handler the two commands act on the row that the user selected last.
      -->
      <Border.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
          <MenuItem Command="{Binding SetModGameCommand}" Header="Set the game of this mod" />
          <Separator />
          <MenuItem Command="{Binding RemoveModCommand}" Header="Remove from the store" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid>
        <!--
          The dashed outline of the ghost. A Border cannot draw a dash, so this is a
          Rectangle over the content. It stays collapsed while nothing drags, and a
          collapsed element costs nothing.
        -->
        <Rectangle
          x:Name="GhostOutline"
          Margin="-5,-3"
          RadiusX="{StaticResource RadiusDefaultPixels}"
          RadiusY="{StaticResource RadiusDefaultPixels}"
          Stroke="{StaticResource AccentDefault}"
          StrokeDashArray="3 3"
          StrokeThickness="1"
          Visibility="Collapsed" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource DragHandleArea}">
            <Path Style="{StaticResource DragHandle}" />
          </Border>

          <ToggleButton
            Grid.Column="1"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Style="{StaticResource TogglePill}" />

          <TextBlock
            Grid.Column="2"
            MinWidth="18"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Style="{StaticResource Hint}"
            Text="{Binding Order}" />

          <StackPanel Grid.Column="3" VerticalAlignment="Center">
            <TextBlock
              x:Name="RowName"
              FontFamily="{StaticResource UiFontFamilyStrong}"
              FontWeight="SemiBold"
              Foreground="{StaticResource TextPrimary}"
              Text="{Binding Name}"
              TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Hint}">
              <Run Text="{Binding Kind, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding GameName, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding FileCount, Mode=OneWay}" />
              <Run Text=" files · " />
              <Run Text="{Binding Size, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentDefault}" />
      </DataTrigger>
      <!--
        The ghost recesses to the window fill and shows the dashed outline. It sets no
        Opacity. Step 10 banned opacity as a color tool, because the software rasterizer
        composites it on every repaint, and a drag repaints often.
      -->
      <DataTrigger Binding="{Binding IsDragSource}" Value="True">
        <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SurfaceBase}" />
        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource BorderDefault}" />
        <Setter TargetName="RowName" Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter TargetName="GhostOutline" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
