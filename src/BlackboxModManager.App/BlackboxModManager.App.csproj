<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BlackboxModManager.App</RootNamespace>
    <AssemblyName>BlackboxModManager</AssemblyName>
    <!-- LZCompressLib.dll is a native x64 library. The host process must be x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The developer machine runs Linux. The Windows Desktop reference pack needs this
         switch to restore there. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Program.Main sets the culture before it starts the application. The entry point
         that WPF generates would run first, so it is not the entry point. -->
    <StartupObject>BlackboxModManager.App.Program</StartupObject>
    <!-- A container save compresses every texture with Parallel.For, and each texture takes
         one large object heap block. One vinyl mod runs that about 27,000 times. Workstation
         collection is the wrong mode for that shape of work. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The installer and the update check. vpk pack reads this build and writes Setup.exe,
         a portable zip, and a package for the release feed.

         This reference sits on the application and never on BlackboxModManager.Core. Core
         holds no network code, and its tests run on native Linux. Keep both facts true.

         Velopack also puts Update.exe beside the application. No Content entry names that
         file, because vpk pack injects it. See THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- A pack URI reads a Resource. It does not read Content or Embedded Resource. Name
         each file, and never glob Fonts/*.ttf. See docs/roadmap/10-dark-theme.md,
         Part B. -->
    <Resource Include="Fonts\Inter_18pt-Regular.ttf" />
    <Resource Include="Fonts\Inter_18pt-SemiBold.ttf" />
    <Resource Include="Fonts\JetBrainsMono-Regular.ttf" />
    <!-- The log used IBM Plex Sans before JetBrains Mono. The file stays as a spare, and
         LogFontFamilyAlternate names it. -->
    <Resource Include="Fonts\IBMPlexSans-Regular.ttf" />
    <!-- The window icon. A pack URI reads this as a Resource, the same as the fonts above.
         ApplicationIcon below sets the icon of the .exe itself, a separate embed. -->
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 7-Zip. Core/Store/SevenZipTool.cs starts 7z.exe as a child process, because
         SharpCompress decodes a solid 7z once for each entry. See
         docs/roadmap/98-known-upstream-defects.md, defect 14.

         Both files stay unmodified, and the license text travels with them. 7-Zip is under
         the GNU LGPL, and that license asks for the notice and for an unmodified library.
         See 7-Zip/7-Zip-License.txt.

         Name each file, and never glob 7-Zip\*. The pair 7z.exe and 7z.dll must match, and
         a glob would carry a stray file of a later copy into the build. -->
    <Content Include="7-Zip\7z.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="7-Zip\7z.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="7-Zip\7-Zip-License.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="7-Zip\7-Zip-readme.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The license of this application and the notices of everything that it ships.

         A notice that stays in the repository reaches nobody. The MIT license of the three
         libraries asks for the copyright notice in every copy, and the 7-Zip release asks a
         redistribution in binary form to reproduce its license information. Both files
         therefore travel with the executable.

         Link keeps the flat name in the output, because the source sits two directories up. -->
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The license of each embedded font.

         A Resource goes inside the assembly, so a build carries three fonts and no license
         text of its own. The SIL Open Font License asks a copy that bundles a font to carry
         the copyright notice and the license. These three files close that gap.

         The .ttf files stay a Resource above. A pack URI cannot read Content. -->
    <Content Include="Fonts\Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fonts\JetBrainsMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fonts\IBMPlexSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackboxModManager.Core\BlackboxModManager.Core.csproj" />
  </ItemGroup>

</Project>
